{
  "name": "panoptes-office",
  "version": "0.2.0",
  "description": "An isometric office that moves along with your Claude Code sessions.",
  "keywords": [
    "claude-code",
    "codex",
    "visualization",
    "sessions",
    "subagents",
    "dashboard"
  ],
  "license": "MIT",
  "author": "smyeong123",
  "homepage": "https://github.com/smyeong123/panoptes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smyeong123/panoptes.git"
  },
  "bugs": {
    "url": "https://github.com/smyeong123/panoptes/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "panoptes": "plugin/dist/panoptes.mjs"
  },
  "files": [
    "plugin/dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
